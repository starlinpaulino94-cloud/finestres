# Obligatorio en producción. Genera al menos 32 bytes aleatorios.
BETTER_AUTH_SECRET=

# URL pública exacta de esta instalación personal.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Credenciales server-only de Totalum.
TOTALUM_API_KEY=
TOTALUM_API_URL=https://api.totalum.app/

# Opcional: orígenes adicionales exactos, separados por coma.
TRUSTED_APP_ORIGINS=
TRUSTED_FRAME_ANCESTORS=

# Sólo desarrollo: origen exacto del editor visual que puede controlar el iframe.
NEXT_PUBLIC_EDITOR_ORIGINS=
