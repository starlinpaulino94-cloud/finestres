{
  "name": "nextjs-totalum-project",
  "description": "Build a full-stack web application with Next.js and Totalum.",
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 DISABLE_OPENNEXT=true next dev --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "check-types-errors": "tsc --noEmit --skipLibCheck",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 DISABLE_OPENNEXT=true next start",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 DISABLE_OPENNEXT=true next build --webpack",
    "cloudflare-build": "cross-env TOTALUM_SOURCE_TAGS=0 opennextjs-cloudflare build",
    "cloudflare-deploy": "cross-env TOTALUM_SOURCE_TAGS=0 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "preview": "cross-env TOTALUM_SOURCE_TAGS=0 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "test:serve": "cross-env TESTING_MODE=true NEXT_TELEMETRY_DISABLED=1 DISABLE_OPENNEXT=true PORT=3000 next start",
    "test:finance": "ts-node --project tsconfig.finance-tests.json scripts/finance-tests.ts",
    "verify:build": "cross-env BETTER_AUTH_SECRET=local-verification-secret-with-32-chars NEXT_PUBLIC_APP_URL=http://localhost:3000 TOTALUM_API_KEY=local-verification-placeholder TOTALUM_API_URL=https://api.totalum.app NEXT_TELEMETRY_DISABLED=1 DISABLE_OPENNEXT=true next build --webpack",
    "verify": "npm run lint && npm run typecheck && npm run test:finance && npm run verify:build"
  },
  "cloudflare": {
    "label": "Totalum App",
    "products": [
      "Workers"
    ],
    "categories": [],
    "icon_urls": [
      "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/5ca0ca32-e897-4699-d4c1-6b680512f000/public"
    ],
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/e42eec61-db86-49c8-7b29-c3ed4783e400/public",
    "publish": true
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.7",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.536.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-day-picker": "^9.8.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "totalum-api-sdk": "^3.0.8",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "24.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cross-env": "^10.1.0",
    "eslint": "9.27.0",
    "eslint-config-next": "^16.3.2",
    "next": "^16.3.2",
    "tailwindcss": "^4.1.1",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.6",
    "typescript": "5.8.3",
    "wrangler": "^4.125.0"
  },
  "private": true
}
